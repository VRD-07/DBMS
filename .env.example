# ============================================================================
# Voltcart - Environment Configuration Example
# Copy this file to .env and configure with your MySQL cloud database details.
# Supported cloud providers: Aiven, TiDB Cloud, Railway, PlanetScale, AWS RDS, Clever Cloud
# ============================================================================

PORT=3000

# Cloud MySQL Database Credentials
DB_HOST=your-mysql-cloud-host.com
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=voltcart_db

# SSL Mode (Set to true for cloud providers requiring TLS/SSL connections)
DB_SSL=true

# Connection Pool Options
DB_CONNECTION_LIMIT=10
